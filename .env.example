CLAIM_CONTRACT=0xYOUR_REVIEWED_CLAIM_CONTRACT
CLAIM_DATA_HEX=0xYOUR_REVIEWED_CALLDATA
TOKENS_TO_SWEEP=0xTOKEN_ADDRESS_1,0xTOKEN_ADDRESS_2
