# Скомпрометированный исходный EOA
SOURCE_PRIVATE_KEY=0xYOUR_SOURCE_PRIVATE_KEY

# Sponsor оплачивает gas; используйте отдельный hot wallet с ограниченным балансом
SPONSOR_PRIVATE_KEY=0xYOUR_SPONSOR_PRIVATE_KEY

# Безопасное хранилище, не совпадающее со sponsor
DESTINATION_ADDRESS=0xYOUR_DESTINATION_ADDRESS

# Адреса должны происходить только из проверенного deployment manifest

RESCUER_ETHEREUM=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_ARBITRUM=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_OPTIMISM=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_POLYGON=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_BASE=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_INK=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_BNB=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_LINEA=0xYOUR_VERIFIED_RESCUER_ADDRESS
RESCUER_SCROLL=0xYOUR_VERIFIED_RESCUER_ADDRESS

# Дополнительные сети по умолчанию отключены
RESCUER_ZKSYNC=
RESCUER_METIS=
RESCUER_GNOSIS=
