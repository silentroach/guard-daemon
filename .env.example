# Этот шаблон намеренно не готов к запуску.
# Адреса, RPC URL и путь manifest ниже являются непускаемыми заглушками.
# Не заменяйте их реальными данными без полного изучения docs/configuration.md.

# Dry-run запрещает подписи и отправку транзакций, но после корректной настройки
# всё равно подключается к RPC чтения и записывает локальное состояние.
DRY_RUN=true

# Обязательные публичные адреса ролей. Все три адреса должны различаться.
SOURCE_ADDRESS=0xYOUR_SOURCE_ADDRESS
SPONSOR_ADDRESS=0xYOUR_SPONSOR_ADDRESS
DESTINATION_ADDRESS=0xYOUR_DESTINATION_ADDRESS

# Обязательный список имён из реестра в нижнем регистре.
ENABLED_NETWORKS=base

# При DRY_RUN=false без emergency ключи обязательны только в окружении процесса.
# Никогда не записывайте SOURCE_PRIVATE_KEY и SPONSOR_PRIVATE_KEY в этот файл.

# Закреплённый canonical artifact из репозитория.
RESCUER_ARTIFACT=artifacts/contracts/RescuerV2.json

# Два независимых провайдера чтения для base. Все значения являются заглушками.
RPC_READ_1_HTTP_BASE=https://read-1.base.example.invalid
RPC_READ_1_WS_BASE=wss://read-1.base.example.invalid/ws
RPC_READ_1_TRUST_DOMAIN_BASE=provider-1.example.invalid
RPC_READ_2_HTTP_BASE=https://read-2.base.example.invalid
RPC_READ_2_WS_BASE=wss://read-2.base.example.invalid/ws
RPC_READ_2_TRUST_DOMAIN_BASE=provider-2.example.invalid

# Доверенный manifest обязателен для каждой сети. Файла по этому пути нет.
RESCUER_MANIFEST_BASE=deployments/YOUR_TRUSTED_BASE_MANIFEST.json
# Для официального manifest укажите его immutable release commit, а не commit
# установленного бинарного файла. Без поля ожидается закреплённое source tree.
# RESCUER_RELEASE_COMMIT_BASE=0123456789abcdef0123456789abcdef01234567

# Безопасный режим токенов по умолчанию.
TOKEN_MODE_BASE=known-only
# Для обычного live-режима задайте правило каждого trusted token:
# TOKEN_VALUE_RULES_BASE=0xTOKEN_ADDRESS:MINIMUM_RAW_BALANCE:MAX_GAS_COST_WEI
# Следующее поле допустимо только вместе с TOKEN_MODE_BASE=allowlist:
# TOKEN_ALLOWLIST_BASE=0xYOUR_TOKEN_ADDRESS_1,0xYOUR_TOKEN_ADDRESS_2

# Сетевые ограничения расходов. Для Base платные операции live заблокированы,
# поскольку комиссию нельзя полностью ограничить полями транзакции.
NETWORK_MAX_TRANSACTION_COST_WEI_BASE=8000000000000000
NETWORK_HOURLY_BUDGET_WEI_BASE=15000000000000000
NETWORK_DAILY_BUDGET_WEI_BASE=25000000000000000
NETWORK_CUMULATIVE_BUDGET_WEI_BASE=40000000000000000
NETWORK_SPONSOR_MIN_BALANCE_WEI_BASE=20000000000000000
MAX_FEE_PER_GAS_WEI_BASE=20000000000
MAX_PRIORITY_FEE_PER_GAS_WEI_BASE=2000000000
TOKEN_GAS_LIMIT_BASE=300000
NATIVE_GAS_LIMIT_BASE=100000
CHAIN_OVERHEAD_MAX_WEI_BASE=500000000000000
NATIVE_MIN_NET_VALUE_WEI_BASE=1000000000000000
UNKNOWN_TOKEN_MAX_TRANSACTION_COST_WEI_BASE=2000000000000000

# RPC отправки запрещён при DRY_RUN=true. В live и emergency поле обязательно,
# но в emergency broadcaster по нему не создаётся.
# RPC_BROADCAST_HTTP_BASE=https://broadcast.base.example.invalid

RPC_READ_TIMEOUT=10s

# При первом запуске без checkpoint демон сканирует ограниченное окно ретроспективного просмотра до согласованного финализированного блока.
# Локальное состояние обязательно для восстановления после сбоя.
# Повреждение state, несовпадение сохранённой идентичности сети или конфигурации и невозможность получить эксклюзивную блокировку являются fail-closed ошибками запуска.
# Checkpoint продвигается только после durable `Ack` соответствующих candidates.
STATE_DIRECTORY=state
WATCH_LOOKBACK_BLOCKS=64

# Общие бюджеты упорядочены: транзакция <= час <= сутки <= накопительный предел.
MAX_TRANSACTION_COST_WEI=10000000000000000
HOURLY_BUDGET_WEI=20000000000000000
DAILY_BUDGET_WEI=30000000000000000
CUMULATIVE_BUDGET_WEI=50000000000000000
SPONSOR_MIN_BALANCE_WEI=20000000000000000
RATE_LIMIT_PER_MINUTE=6

# Ограничения злоупотреблений, аварийная остановка и задержка предупреждений.
ABUSE_WINDOW=1h
MAX_NEW_UNKNOWN_TOKENS_PER_WINDOW=16
MAX_ATTEMPTS_PER_TOKEN_WINDOW=3
MAX_ATTEMPTS_PER_SOURCE_EVENT=3
EMERGENCY_STOP=false
ALERT_COOLDOWN=15m

# Для другой записи реестра повторите все сетевые поля с суффиксом
# ETHEREUM, ARBITRUM, OPTIMISM, POLYGON, INK, SCROLL, LINEA, METIS или BNB.
