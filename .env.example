# Безопасный режим по умолчанию: без подписания и отправки транзакций.
DRY_RUN=true

# Обязательные публичные адреса ролей. Все три адреса должны различаться.
SOURCE_ADDRESS=0xYOUR_SOURCE_ADDRESS
SPONSOR_ADDRESS=0xYOUR_SPONSOR_ADDRESS
DESTINATION_ADDRESS=0xYOUR_DESTINATION_ADDRESS

# Обязательный список сетей в нижнем регистре. Здесь показана только base.
ENABLED_NETWORKS=base

# При DRY_RUN=false ключи обязательны только в окружении процесса.
# Не записывайте SOURCE_PRIVATE_KEY и SPONSOR_PRIVATE_KEY в этот файл.

# Проверяемый артефакт контракта.
RESCUER_ARTIFACT=artifacts/contracts/RescuerV2.json

# Два независимых провайдера чтения для base. URL ниже являются заглушками.
RPC_READ_1_HTTP_BASE=https://read-1.base.example.invalid
RPC_READ_1_WS_BASE=wss://read-1.base.example.invalid/ws
RPC_READ_1_TRUST_DOMAIN_BASE=provider-1.example.invalid
RPC_READ_2_HTTP_BASE=https://read-2.base.example.invalid
RPC_READ_2_WS_BASE=wss://read-2.base.example.invalid/ws
RPC_READ_2_TRUST_DOMAIN_BASE=provider-2.example.invalid

# Доверенный манифест обязателен для каждой включённой сети.
RESCUER_MANIFEST_BASE=deployments/YOUR_TRUSTED_BASE_MANIFEST.json

# Безопасный режим токенов по умолчанию.
TOKEN_MODE_BASE=known-only
# Укажите только вместе с TOKEN_MODE_BASE=allowlist:
# TOKEN_ALLOWLIST_BASE=0xYOUR_TOKEN_ADDRESS_1,0xYOUR_TOKEN_ADDRESS_2

# RPC отправки допустим и обязателен только при DRY_RUN=false.
# RPC_BROADCAST_HTTP_BASE=https://broadcast.base.example.invalid

RPC_READ_TIMEOUT=10s

# При первом запуске без checkpoint демон сканирует ограниченное окно ретроспективного просмотра до согласованного финализированного блока.
# Локальное состояние обязательно для восстановления после сбоя.
# Повреждение state, несовпадение сохранённой идентичности сети или конфигурации и невозможность получить эксклюзивную блокировку являются fail-closed ошибками запуска.
# Checkpoint продвигается только после durable `Ack` соответствующих candidates.
STATE_DIRECTORY=state
WATCH_LOOKBACK_BLOCKS=64

# Эти поля пока только разбираются и проверяются как входы политики Task 08.
MAX_TRANSACTION_COST_WEI=10000000000000000
CUMULATIVE_BUDGET_WEI=50000000000000000
SPONSOR_MIN_BALANCE_WEI=20000000000000000
RATE_LIMIT_PER_MINUTE=6

# Для других поддерживаемых сетей повторите сетевые поля с суффиксом
# ETHEREUM, ARBITRUM, OPTIMISM, POLYGON, INK, SCROLL, LINEA, METIS или BNB.
